<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Srimathi Mart</display-name>

    <!--
        Servlets and the data source listener are registered with annotations.
        Filters are declared here on purpose: @WebFilter gives no guaranteed
        ordering, and EncodingFilter must run before AuthFilter so that a
        rejected request is still decoded as UTF-8.
    -->

    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.srimathi.srimathimart.filter.EncodingFilter</filter-class>
    </filter>

    <filter>
        <filter-name>authFilter</filter-name>
        <filter-class>com.srimathi.srimathimart.filter.AuthFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>authFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>


    <!-- Explicit idle timeout. LoginServlet also sets this per session so the
         value can be tuned from config.properties without a redeploy. -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <!-- Set to true once the app is served over HTTPS. -->
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>


    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>


    <error-page>
        <error-code>404</error-code>
        <location>/index.html</location>
    </error-page>

</web-app>
